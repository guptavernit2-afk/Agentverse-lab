# Optional Uvicorn process environment defaults.
# The documented start command sets both values explicitly.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Optional database override. Defaults to the checkout's .local/lab.sqlite.
# AGENTVERSE_DB=

# Opt-in for a separately authorized live dashboard experiment.
AGENTVERSE_ENABLE_LIVE=0
# AGENTVERSE_GEMINI_MODEL=
# Supply GEMINI_API_KEY through the server process environment.
